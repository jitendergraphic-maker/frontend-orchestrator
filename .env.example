# Backend / FastAPI — copy to backend/.env and fill keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DATABASE_URL=sqlite:///./orchestrator.sqlite
# DATABASE_URL=postgresql+psycopg://orchestrator:orchestrator@localhost:5432/orchestrator
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
COARENA_API_KEY=
COHERE_API_KEY=
SAMBANOVA_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Comma-separated; must include your Vercel origin exactly (https, no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://ai-orchestrator-engine.vercel.app
COMPLETION_MAX_TOKENS=1536
ALLOW_MOCK_FALLBACK=false
